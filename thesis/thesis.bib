@inproceedings{ma_protracer_2016,
	address = {San Diego, CA},
	title = {{ProTracer}: {Towards} {Practical} {Provenance} {Tracing} by {Alternating} {Between} {Logging} and {Tainting}},
	isbn = {978-1-891562-41-9},
	shorttitle = {{ProTracer}},
