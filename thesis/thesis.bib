	file = {IEEE Xplore Abstract Record:/home/sam/Zotero/storage/E3UB24EQ/4086137.html:text/html;Submitted Version:/home/sam/Zotero/storage/ITHSVQR4/Yi et al. - 2006 - Evaluating Benchmark Subsetting Approaches.pdf:application/pdf},
